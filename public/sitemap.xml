<?xml version="1.0" encoding="UTF-8"?>
<!--
  Every URL here must be served with status 200. Each sub-route is a directory
  with its own index.html, generated by scripts/postbuild.mjs, and that script
  fails the build if any <loc> in this file has no file behind it.

  The trailing slash is the canonical form: it is what the host answers 200 for.
  The bare form (/about) is redirected to it.

  There are no hreflang annotations, deliberately. All three languages are served
  by these same URLs — the language is client state and nothing reads a ?lang=
  parameter — so alternates would point at URLs that canonicalise back here,
  which Google ignores. See the note in index.html.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://www.harvest.cn/</loc>
    <lastmod>2026-09-23</lastmod>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://www.harvest.cn/about/</loc>
    <lastmod>2026-09-23</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
